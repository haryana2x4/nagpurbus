# NagpurBus Configuration Template
# Copy to .env and adjust. Never commit secrets.

# --- Environment & Truth-in-Data Mode ---
NAGPURBUS_ENV=development
# Set true ONLY in dev when running the fleet simulator. Forces SIMULATED banner everywhere.
ENABLE_SIMULATOR=false

# --- Database & Redis (Docker Compose defaults) ---
DATABASE_URL=postgresql+psycopg://nagpurbus:nagpurbus_dev@localhost:5432/nagpurbus
REDIS_URL=redis://localhost:6379/0
# Local SQLite fallback path for offline / no-Docker dev inspection (PostgreSQL+PostGIS is primary)
SQLITE_FALLBACK_PATH=data/processed/nagpurbus_static.sqlite3

# --- Official GTFS Static + GTFS-Realtime (Auto-switch when configured) ---
# Leave blank until NMC / NMPL or Maha Metro provides an official permitted URL.
GTFS_STATIC_URL=
GTFS_STATIC_API_KEY=
GTFS_RT_VEHICLE_POSITIONS_URL=
GTFS_RT_TRIP_UPDATES_URL=
GTFS_RT_ALERTS_URL=
GTFS_RT_API_KEY=
GTFS_RT_POLL_INTERVAL_S=15

# --- OpenStreetMap Ingest ---
# Nagpur metropolitan bbox covering NMC, MIHAN, Khapri, Hingna, Wathoda, Hudkeshwar, Butibori, Kamptee
OSM_BBOX_SOUTH=20.88
OSM_BBOX_WEST=78.90
OSM_BBOX_NORTH=21.28
OSM_BBOX_EAST=79.26
OSM_OVERPASS_MIRRORS=https://maps.mail.ru/osm/tools/overpass/api/interpreter,https://overpass-api.de/api/interpreter,https://overpass.kumi.systems/api/interpreter
OSM_USER_AGENT=NagpurBus-OpenTransit/0.1 (contact: maintainers@nagpurbus.local)

# --- Map Tiles (OSM-derived, no paid keys, ODbL attribution required) ---
MAPLIBRE_STYLE_URL=https://tiles.openfreemap.org/styles/liberty

# --- Privacy (DPDP Act 2023) ---
RAW_PING_RETENTION_HOURS=24
CROWD_SESSION_MAX_HOURS=2

# --- Journey Planner ---
MAX_WALK_DISTANCE_M=600
